# Copy this file to .env.local (git-ignored). No trailing slashes.

# Where the app sends API calls.
#   Local dev (recommended): /api  — Vite forwards it to VITE_DEV_API_TARGET,
#     so the refresh cookie is same-origin and just works.
#   Production: the API on the same site as the app, e.g. https://api.digihealth.ng/api
#     (same registrable domain as the frontend, so the cookie isn't a third-party cookie).
VITE_API_BASE=/api

# Local dev only: where Vite forwards /api.
VITE_DEV_API_TARGET=http://localhost:8080
